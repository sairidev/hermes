# ============================================================
#  Hermes Agent (web) — konfigurasi
#  Otomatis dibuat jadi .env saat start pertama.
#  Di Pterodactyl, variabel dari panel (tab Startup) mengalahkan file ini.
# ============================================================

# --- Koneksi ke 9Router (WAJIB) ------------------------------
# Alamat 9Router kamu yang jalan terpisah (server/panel lain).
# Contoh: http://123.45.67.89:20128   atau   https://9router.domainkamu.com
NINEROUTER_URL=

# API key dari dashboard 9Router → menu API Keys → Create.
NINEROUTER_API_KEY=

# Model di 9Router yang dipakai Hermes (ID model atau nama combo).
# Contoh: kr/claude-sonnet-4.5, cc/claude-sonnet-4-5, gh/gpt-5, nama-combo-kamu
# Ketik "models" di console untuk melihat daftar dari 9Router kamu.
HERMES_MODEL=kr/claude-sonnet-4.5

# --- Login dashboard Hermes ----------------------------------
# Kosong = password dibuat acak saat start pertama (lihat console / data/secrets.json).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Fitur Hermes --------------------------------------------
# Extra Python Hermes. Tambah telegram / discord / slack kalau mau bot chat.
HERMES_EXTRAS=web,pty,mcp

# true = jalankan juga "hermes gateway" (bot Telegram/Discord/dll, atur di dashboard Hermes)
HERMES_GATEWAY=false

# true = izinkan Hermes mengunduh komponen tambahan sendiri saat fitur dipakai
# (Python/Chromium/tirith, bisa ±500 MB+). false = hemat & bisa diprediksi (disarankan di panel).
HERMES_LAZY_INSTALLS=false

# --- Server --------------------------------------------------
# Port publik. Di Pterodactyl otomatis pakai SERVER_PORT (port alokasi).
PORT=3000
HOST=0.0.0.0

# Opsional: URL publik kalau pakai domain, contoh https://hermes.domainkamu.com
PUBLIC_URL=

# true hanya kalau ada reverse proxy (Nginx/Cloudflare Tunnel) di depan server ini
TRUST_PROXY=false

# --- Build (biasanya tidak perlu diubah) ---------------------
# Hapus node_modules & cache setelah build supaya hemat disk (~500 MB)
CLEAN_BUILD_DEPS=true
# Batas RAM Node.js saat build dashboard Hermes (MB)
BUILD_MEMORY_MB=1536
